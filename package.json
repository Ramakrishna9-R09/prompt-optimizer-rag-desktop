{
  "name": "prompt-optimizer",
  "version": "1.2.0",
  "description": "AI Prompt Autopilot with local RAG, ranked suggestions, global shortcuts, and IDE handoff",
  "main": "gui/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "smoke:rag": "node scripts/smoke-rag.js",
    "release:check": "node scripts/release-check.js",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --dir --config.win.signExecutable=false",
    "build:win": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win --config.win.signExecutable=false"
  },
  "author": "Prompt Optimizer Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.promptoptimizer.desktop",
    "productName": "Prompt Optimizer",
    "directories": {
      "output": "../dist-advanced-rag-release"
    },
    "files": [
      "core/**/*",
      "adapters/**/*",
      "gui/**/*",
      "build/icon.ico",
      "PRIVACY.md",
      "TERMS.md",
      "PAYMENT.md",
      "SECURITY.md",
      "LICENSE",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prompt Optimizer",
      "uninstallDisplayName": "Prompt Optimizer",
      "deleteAppDataOnUninstall": false
    }
  }
}
